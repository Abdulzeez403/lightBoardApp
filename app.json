{
  "expo": {
    "name": "lightBoard",
    "slug": "lightBoard",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "your-app-scheme",
    "icon": "./assets/LB.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/LIGHTBOARD.png",
      "backgroundColor": "#1E90FF"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.sodiqabdulazeez.lightBoard"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
